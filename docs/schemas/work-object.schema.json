{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkObject",
  "type": "object",
  "required": [
    "id",
    "contract",
    "status",
    "events",
    "effects",
    "artifacts",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "waiting_verification",
        "verified",
        "partial",
        "waiting_lease",
        "failed",
        "unresolved",
        "unverifiable",
        "cancelled"
      ]
    },
    "contract": {
      "type": "object",
      "required": [
        "objective",
        "success",
        "deliverables",
        "riskClass"
      ],
      "properties": {
        "objective": {
          "type": "string"
        },
        "inputs": {
          "type": "object"
        },
        "constraints": {
          "type": "object"
        },
        "success": {
          "type": "array"
        },
        "deliverables": {
          "type": "array"
        },
        "riskClass": {
          "enum": [
            "read",
            "local_write",
            "external_write",
            "destructive",
            "financial"
          ]
        },
        "approvalRequired": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "type": "array"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attemptLog": {
            "type": "array"
          },
          "kind": {
            "enum": [
              "forward",
              "compensation"
            ]
          },
          "sourceEffectId": {
            "type": "string"
          }
        }
      }
    },
    "sagas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sagaId",
          "status",
          "forwardEffectIds",
          "compensationEffectIds",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "sagaId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "running",
              "partial",
              "compensated",
              "unresolved",
              "failed"
            ]
          },
          "forwardEffectIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compensationEffectIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array"
    },
    "verification": {
      "type": [
        "object",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
