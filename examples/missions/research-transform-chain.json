{
  "objective": "Research suppliers, then transform the verified research artifact",
  "inputs": {
    "inputPath": "./work-runs/multi-capability-research.json",
    "outputPath": "./work-runs/multi-capability-selected.json",
    "select": ["name", "website"],
    "sortBy": { "field": "name", "direction": "asc" },
    "limit": 4
  },
  "success": [
    {
      "id": "selected-artifact",
      "description": "The transformed supplier artifact matches the deterministic transform verifier",
      "verifier": "pack.transform.json",
      "required": true
    }
  ],
  "deliverables": [
    "./work-runs/multi-capability-selected.json"
  ],
  "riskClass": "local_write",
  "steps": [
    {
      "id": "research",
      "operation": "research_suppliers",
      "capability": "pack.research.local",
      "input": {
        "dataPath": "./lab/data/suppliers.json",
        "outputPath": "./work-runs/multi-capability-research.json",
        "minRecords": 4
      },
      "idempotencyKey": "multi-capability:research:v1",
      "riskClass": "local_write"
    },
    {
      "id": "transform",
      "operation": "transform",
      "capability": "pack.transform.json",
      "input": {
        "inputPath": "./work-runs/multi-capability-research.json",
        "outputPath": "./work-runs/multi-capability-selected.json",
        "select": ["name", "website"],
        "sortBy": { "field": "name", "direction": "asc" },
        "limit": 4
      },
      "idempotencyKey": "multi-capability:transform:v1",
      "riskClass": "local_write"
    }
  ],
  "proofPath": "./work-runs/multi-capability-proof.json",
  "workDirectory": "./work-runs"
}
