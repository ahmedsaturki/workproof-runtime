{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "lab/**/*.ts",
    "test/**/*.ts",
    "types/**/*.d.ts"
  ]
}
