{
  "name": "operational-reality-core",
  "version": "3.4.0-dev.6",
  "private": true,
  "description": "WorkProof Runtime — outcome-first digital work kernel and local-first operator",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "demo": "npm run build && node dist/apps/demo.js",
    "cli": "npm run build && node dist/packages/cli/src/index.js",
    "benchmark": "npm run build && node dist/apps/benchmark.js",
    "check": "npm test && npm run benchmark && npm run demo && node dist/packages/cli/src/index.js verify mission-proof.json && node dist/packages/cli/src/index.js run examples/missions/research-local.json",
    "live-github-smoke": "npm run build && node dist/apps/github-smoke.js",
    "registry-server": "npm run build && node dist/apps/registry-server.js",
    "studio": "npm run build && node dist/apps/studio.js"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "workctl": "dist/packages/cli/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SPEC.md",
    "ARCHITECTURE.md",
    "docs/EXTENSION-CONTRACT.md",
    "docs/schemas"
  ]
}
